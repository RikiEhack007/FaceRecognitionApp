<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Backgrounds  -->
    <SolidColorBrush x:Key="BgPrimary" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BgSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgSurfaceDim" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BgDark" Color="#0F172A" />
    <SolidColorBrush x:Key="BgCameraOff" Color="#E2E8F0" />

    <!--  Borders  -->
    <SolidColorBrush x:Key="BorderDefault" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderLight" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BorderFocus" Color="#2563EB" />

    <!--  Text  -->
    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B" />
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextOnDark" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

    <!--  Accent  -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentDanger" Color="#EF4444" />
    <SolidColorBrush x:Key="AccentDangerHover" Color="#DC2626" />
    <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />

    <!--  Status surfaces  -->
    <SolidColorBrush x:Key="BgWarning" Color="#FFFBEB" />
    <SolidColorBrush x:Key="TextWarning" Color="#92400E" />
    <SolidColorBrush x:Key="BgSuccess" Color="#F0FDF4" />
    <SolidColorBrush x:Key="TextSuccess" Color="#15803D" />
    <SolidColorBrush x:Key="BgError" Color="#FEF2F2" />
    <SolidColorBrush x:Key="TextError" Color="#EF4444" />
    <SolidColorBrush x:Key="BgInfoLight" Color="#F0F4F8" />
    <SolidColorBrush x:Key="TextInfo" Color="#4A6785" />

    <!--  Step Indicator  -->
    <SolidColorBrush x:Key="StepActive" Color="#2563EB" />
    <SolidColorBrush x:Key="StepComplete" Color="#22C55E" />
    <SolidColorBrush x:Key="StepInactive" Color="#CBD5E1" />

    <!--  Button surfaces  -->
    <SolidColorBrush x:Key="BtnDefault" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BtnDefaultHover" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BtnDefaultPress" Color="#CBD5E1" />

    <!--  ComboBox dark  -->
    <SolidColorBrush x:Key="ComboDarkBg" Color="#1E293B" />
    <SolidColorBrush x:Key="ComboDarkBgHover" Color="#334155" />
    <SolidColorBrush x:Key="ComboDarkBorder" Color="#475569" />
    <SolidColorBrush x:Key="ComboDarkText" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ComboDarkItemHover" Color="#475569" />

</ResourceDictionary>
