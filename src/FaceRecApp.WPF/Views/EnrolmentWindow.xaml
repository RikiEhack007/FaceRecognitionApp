<Window
    x:Class="FaceRecApp.WPF.Views.EnrolmentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FaceRecApp.WPF.Controls"
    Title="Patient Enrolment"
    Width="860"
    Height="800"
    Background="{DynamicResource BgPrimary}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ═══════════════════════════════════  -->
        <!--  HEADER (Title + Edit Banner)  -->
        <!--  ═══════════════════════════════════  -->
        <StackPanel Grid.Row="0">
            <!--  Edit Mode Banner  -->
            <Border
                x:Name="EditBanner"
                Margin="0,0,0,8"
                Padding="12,8"
                Background="{DynamicResource BgInfoLight}"
                BorderBrush="{DynamicResource AccentPrimary}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextInfo}"
                        Text="Editing patient — PID:" />
                    <TextBlock
                        x:Name="EditBannerPid"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Style="{DynamicResource PidText}" />
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="WindowTitle"
                Style="{DynamicResource PageTitle}"
                Text="Patient Enrolment" />
        </StackPanel>

        <!--  Step Indicator  -->
        <controls:StepIndicator x:Name="StepIndicatorControl" Grid.Row="2" />

        <!--  ═══════════════════════════════════  -->
        <!--  STEP CONTENT AREA  -->
        <!--  ═══════════════════════════════════  -->

        <!--  Step 1: e-Consent  -->
        <Border
            x:Name="Step1Panel"
            Grid.Row="4"
            Style="{DynamicResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        Style="{DynamicResource SectionHeader}"
                        Text="BIOMETRIC DATA CONSENT" />
                    <TextBlock
                        x:Name="ConsentTextBlock"
                        Margin="0,0,0,16"
                        LineHeight="22"
                        Style="{DynamicResource BodyText}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Style="{DynamicResource CaptionText}"
                        Text="Purposes:" />
                    <TextBlock
                        Margin="16,0,0,16"
                        LineHeight="20"
                        Style="{DynamicResource CaptionText}"
                        TextWrapping="Wrap">
                        1. Accurate Identification — prevent patient mix-ups<LineBreak />
                        2. Faster Service — instant check-in for future visits<LineBreak />
                        3. Data Security — strictly confidential, high-security standards</TextBlock>

                    <CheckBox
                        x:Name="ConsentCheckBox"
                        Margin="0,8,0,0"
                        FontSize="14"
                        Foreground="{DynamicResource TextPrimary}">
                        <TextBlock FontWeight="SemiBold" Text="I Agree to biometric data collection" />
                    </CheckBox>

                    <StackPanel
                        x:Name="DeclinePanel"
                        Margin="0,12,0,0"
                        Visibility="Collapsed">
                        <TextBlock Style="{DynamicResource FieldLabel}" Text="Reason for declining (required):" />
                        <TextBox
                            x:Name="DeclineReasonInput"
                            Height="60"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Style="{DynamicResource InputBox}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Step 2: Demographics  -->
        <Border
            x:Name="Step2Panel"
            Grid.Row="4"
            Style="{DynamicResource Card}"
            Visibility="Collapsed">
            <ScrollViewer Padding="2,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{DynamicResource SectionHeader}"
                        Text="PATIENT DEMOGRAPHICS" />

                    <!--  PID (edit mode)  -->
                    <StackPanel
                        x:Name="PidPanel"
                        Margin="0,0,0,12"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource FieldLabel}"
                            Text="PID:" />
                        <TextBlock
                            x:Name="PidDisplay"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Style="{DynamicResource PidText}" />
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource FieldLabel}"
                            Text="Admitted:" />
                        <TextBlock
                            x:Name="AdmissionDateDisplay"
                            VerticalAlignment="Center"
                            Style="{DynamicResource MutedText}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="PidHint"
                        Margin="0,0,0,12"
                        Style="{DynamicResource MutedText}"
                        Text="PID will be assigned on save" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Row 0: Full Name + Sex  -->
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Full Name *" />
                            <TextBox x:Name="FullNameInput" Style="{DynamicResource InputBox}" />
                            <TextBlock x:Name="FullNameError" Style="{DynamicResource ErrorText}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Sex *" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <RadioButton
                                    x:Name="SexMale"
                                    Margin="0,0,28,0"
                                    Content="Male"
                                    GroupName="Sex" />
                                <RadioButton
                                    x:Name="SexFemale"
                                    Content="Female"
                                    GroupName="Sex" />
                            </StackPanel>
                            <TextBlock x:Name="SexError" Style="{DynamicResource ErrorText}" />
                        </StackPanel>

                        <!--  Row 1: Burmese + Karen Name  -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Burmese Name" />
                            <TextBox x:Name="BurmeseNameInput" Style="{DynamicResource InputBox}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Karen Name" />
                            <TextBox x:Name="KarenNameInput" Style="{DynamicResource InputBox}" />
                        </StackPanel>

                        <!--  Row 2: Date of Birth (structured grid layout)  -->
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Date of Birth" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Style="{DynamicResource CaptionText}"
                                        Text="Year" />
                                    <TextBox x:Name="DOBYearInput" Style="{DynamicResource InputBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Style="{DynamicResource CaptionText}"
                                        Text="Month" />
                                    <ComboBox x:Name="DOBMonthCombo" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Style="{DynamicResource CaptionText}"
                                        Text="Day" />
                                    <ComboBox x:Name="DOBDayCombo" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="DobYearError" Style="{DynamicResource ErrorText}" />
                            <TextBlock
                                x:Name="DobWarningLabel"
                                Style="{DynamicResource WarningText}"
                                Text="Approximate DOB — age will be estimated" />
                            <TextBlock
                                x:Name="AgeDisplay"
                                Margin="0,4,0,0"
                                Style="{DynamicResource CaptionText}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="AgeOnAdmissionDisplay"
                                Margin="0,2,0,0"
                                Style="{DynamicResource MutedText}"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <!--  Row 3: Mother (PID + Name sub-grid) + Father  -->
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Mother" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Style="{DynamicResource CaptionText}"
                                        Text="PID" />
                                    <TextBox x:Name="MotherPIDInput" Style="{DynamicResource InputBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Style="{DynamicResource CaptionText}"
                                        Text="Name" />
                                    <TextBox x:Name="MotherNameInput" Style="{DynamicResource InputBox}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="2"
                            Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Father Name" />
                            <TextBox
                                x:Name="FatherNameInput"
                                Margin="0,26,0,0"
                                Style="{DynamicResource InputBox}" />
                        </StackPanel>

                        <!--  Row 4: Spouse + Phone  -->
                        <StackPanel
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Spouse Name" />
                            <TextBox x:Name="SpouseNameInput" Style="{DynamicResource InputBox}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="4"
                            Grid.Column="2"
                            Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Phone Number" />
                            <TextBox x:Name="PhoneNumberInput" Style="{DynamicResource InputBox}" />
                        </StackPanel>

                        <!--  Row 5: Address  -->
                        <StackPanel
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Address Code" />
                            <TextBox x:Name="AddressCodeInput" Style="{DynamicResource InputBox}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="5"
                            Grid.Column="2"
                            Margin="0,0,0,14">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Address (other)" />
                            <TextBox x:Name="AddressOtherInput" Style="{DynamicResource InputBox}" />
                        </StackPanel>

                        <!--  Row 6: Notes (full width)  -->
                        <StackPanel
                            Grid.Row="6"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,0,0,4">
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Notes" />
                            <TextBox
                                x:Name="NotesInput"
                                Height="60"
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True"
                                Style="{DynamicResource InputBox}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Step 3: Deduplication Check  -->
        <Border
            x:Name="Step3Panel"
            Grid.Row="4"
            Style="{DynamicResource Card}"
            Visibility="Collapsed">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    Style="{DynamicResource SectionHeader}"
                    Text="DEDUPLICATION CHECK" />
                <TextBlock
                    x:Name="DedupStatusText"
                    Margin="0,0,0,12"
                    Style="{DynamicResource BodyText}"
                    TextWrapping="Wrap" />

                <ListBox
                    x:Name="DedupResultsList"
                    MaxHeight="200"
                    Margin="0,0,0,12"
                    Background="Transparent"
                    BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,4"
                                Padding="10,8"
                                Background="{DynamicResource BgSurfaceDim}"
                                CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentPrimary}"
                                        Text="{Binding IDCard}" />
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextMuted}"
                                        Text="{Binding CreatedAt, StringFormat='({0:dd/MM/yyyy})'}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    x:Name="DedupInstructions"
                    Style="{DynamicResource CaptionText}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!--  Step 4: Face Capture  -->
        <Border
            x:Name="Step4Panel"
            Grid.Row="4"
            Padding="0"
            ClipToBounds="True"
            Style="{DynamicResource Card}"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <!--  Camera Preview  -->
                <Grid Grid.Column="0">
                    <Image
                        x:Name="PreviewImage"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Stretch="Uniform" />
                    <TextBlock
                        x:Name="PreviewPlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextMuted}"
                        Text="Camera preview" />
                </Grid>

                <!--  Capture Controls  -->
                <StackPanel Grid.Column="2" Margin="0,16,16,16">
                    <TextBlock
                        Margin="0,0,0,12"
                        Style="{DynamicResource SectionHeader}"
                        Text="FACE CAPTURE" />

                    <TextBlock
                        Margin="0,0,0,12"
                        LineHeight="20"
                        Style="{DynamicResource CaptionText}"
                        TextWrapping="Wrap">
                        Face the camera directly and click Capture.
                    </TextBlock>

                    <Button
                        x:Name="CaptureButton"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Stretch"
                        Click="OnCaptureClick"
                        Content="Capture Face"
                        Style="{DynamicResource BtnPrimary}" />

                    <!--  Biometric re-capture warning (edit mode)  -->
                    <TextBlock
                        x:Name="FaceRecaptureWarning"
                        Margin="0,0,0,8"
                        Style="{DynamicResource WarningText}"
                        Text="New capture will add to existing biometrics"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,8,0,2"
                        Style="{DynamicResource FieldLabel}"
                        Text="Biometric Remark:" />
                    <ComboBox x:Name="FaceRemarkCombo" Margin="0,0,0,12" />

                    <Border
                        Padding="10,8"
                        Background="{DynamicResource BgSurfaceDim}"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBlock
                            x:Name="CaptureStatusLabel"
                            Style="{DynamicResource CaptionText}"
                            Text="Ready to capture"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Step 5: Fingerprint Capture  -->
        <Border
            x:Name="Step5Panel"
            Grid.Row="4"
            Style="{DynamicResource Card}"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <!--  Fingerprint Image Preview  -->
                <Grid Grid.Column="0">
                    <Border
                        Padding="20"
                        Background="{DynamicResource BgSurfaceDim}"
                        CornerRadius="6">
                        <Image
                            x:Name="FingerprintPreview"
                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                            Stretch="Uniform" />
                    </Border>
                    <TextBlock
                        x:Name="FingerprintPlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextMuted}"
                        Text="Place finger on scanner" />
                </Grid>

                <!--  Controls  -->
                <StackPanel Grid.Column="2" Margin="0,16,16,16">
                    <TextBlock
                        Margin="0,0,0,12"
                        Style="{DynamicResource SectionHeader}"
                        Text="FINGERPRINT CAPTURE" />

                    <TextBlock Style="{DynamicResource FieldLabel}" Text="Select Finger:" />
                    <ComboBox x:Name="FingerTypeCombo" Margin="0,0,0,10" />

                    <TextBlock
                        x:Name="FpCaptureProgress"
                        Margin="0,0,0,8"
                        Style="{DynamicResource CaptionText}"
                        Text="0 of 3 captures" />

                    <Border
                        Margin="0,0,0,10"
                        Padding="10,8"
                        Background="{DynamicResource BgSurfaceDim}"
                        BorderBrush="{DynamicResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBlock
                            x:Name="FpStatusLabel"
                            Style="{DynamicResource CaptionText}"
                            Text="Scanner not connected"
                            TextWrapping="Wrap" />
                    </Border>

                    <TextBlock
                        Margin="0,8,0,2"
                        Style="{DynamicResource FieldLabel}"
                        Text="Fingerprint Remark:" />
                    <ComboBox x:Name="FingerprintRemarkCombo" Margin="0,0,0,8" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ═══════════════════════════════════  -->
        <!--  NAVIGATION BUTTONS  -->
        <!--  ═══════════════════════════════════  -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Grid.Column="0"
                Click="OnBackClick"
                Content="Back"
                Style="{DynamicResource BtnBase}"
                Visibility="Collapsed" />

            <Button
                x:Name="NextButton"
                Grid.Column="2"
                Click="OnNextClick"
                Content="Next"
                Style="{DynamicResource BtnPrimary}" />

            <Button
                Grid.Column="4"
                Click="OnCancelClick"
                Content="Cancel"
                Style="{DynamicResource BtnBase}" />
        </Grid>
    </Grid>
</Window>
