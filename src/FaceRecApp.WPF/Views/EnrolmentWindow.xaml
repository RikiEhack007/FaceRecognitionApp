<Window x:Class="FaceRecApp.WPF.Views.EnrolmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FaceRecApp.WPF.Controls"
        Title="Patient Enrolment"
        Height="760" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════ -->
        <!-- HEADER (Title + Edit Banner)        -->
        <!-- ═══════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <!-- Edit Mode Banner -->
            <Border x:Name="EditBanner" Visibility="Collapsed"
                    Background="{StaticResource BgInfoLight}"
                    BorderBrush="{StaticResource AccentPrimary}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Editing patient — PID:"
                               Foreground="{StaticResource TextInfo}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="EditBannerPid"
                               Style="{StaticResource PidText}" FontSize="14"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="WindowTitle" Text="Patient Enrolment"
                       Style="{StaticResource PageTitle}"/>
        </StackPanel>

        <!-- Step Indicator -->
        <controls:StepIndicator x:Name="StepIndicatorControl" Grid.Row="2"/>

        <!-- ═══════════════════════════════════ -->
        <!-- STEP CONTENT AREA                   -->
        <!-- ═══════════════════════════════════ -->

        <!-- Step 1: e-Consent -->
        <Border x:Name="Step1Panel" Grid.Row="4" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="BIOMETRIC DATA CONSENT" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="ConsentTextBlock" TextWrapping="Wrap"
                               Style="{StaticResource BodyText}" LineHeight="22"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Purposes:" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" LineHeight="20"
                               Margin="16,0,0,16">
                        1. Accurate Identification — prevent patient mix-ups
                        <LineBreak/>
                        2. Faster Service — instant check-in for future visits
                        <LineBreak/>
                        3. Data Security — strictly confidential, high-security standards
                    </TextBlock>

                    <CheckBox x:Name="ConsentCheckBox" Margin="0,8,0,0"
                              FontSize="14" Foreground="{StaticResource TextPrimary}">
                        <TextBlock Text="I Agree to biometric data collection" FontWeight="SemiBold"/>
                    </CheckBox>

                    <StackPanel x:Name="DeclinePanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Reason for declining (required):" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DeclineReasonInput" Style="{StaticResource InputBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Step 2: Demographics -->
        <Border x:Name="Step2Panel" Grid.Row="4" Style="{StaticResource Card}" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="PATIENT DEMOGRAPHICS" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,4"/>

                    <!-- PID + Admission Date (visible in edit mode / after assignment) -->
                    <StackPanel x:Name="PidPanel" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock Text="PID:" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="PidDisplay" Style="{StaticResource PidText}" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="Admitted:" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="AdmissionDateDisplay" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Create mode hint -->
                    <TextBlock x:Name="PidHint" Text="PID will be assigned on save"
                               Style="{StaticResource MutedText}" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Full Name + Sex -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Fullname (Eng) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FullNameInput" Style="{StaticResource InputBox}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="FullNameError" Style="{StaticResource ErrorText}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Sex *" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                <RadioButton x:Name="SexMale" Content="Male" GroupName="Sex" Margin="0,0,24,0"/>
                                <RadioButton x:Name="SexFemale" Content="Female" GroupName="Sex"/>
                            </StackPanel>
                            <TextBlock x:Name="SexError" Style="{StaticResource ErrorText}"/>
                        </StackPanel>

                        <!-- Row 1: Burmese Name + Karen Name -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                            <TextBlock Text="Burmese Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BurmeseNameInput" Style="{StaticResource InputBox}" Margin="0,0,0,6"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,6,0,0">
                            <TextBlock Text="Karen Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="KarenNameInput" Style="{StaticResource InputBox}" Margin="0,0,0,6"/>
                        </StackPanel>

                        <!-- Row 2: DOB -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <TextBlock Text="Birthdate (ymd)" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBox x:Name="DOBYearInput" Style="{StaticResource InputBox}"
                                         Width="80" Margin="0,0,6,0"/>
                                <TextBlock Text="Year" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox x:Name="DOBMonthCombo" Width="140" Margin="0,0,6,0"/>
                                <TextBlock Text="Month" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox x:Name="DOBDayCombo" Width="100" Margin="0,0,6,0"/>
                                <TextBlock Text="Day" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="DobYearError" Style="{StaticResource ErrorText}"/>
                            <TextBlock x:Name="DobWarningLabel" Style="{StaticResource WarningText}"
                                       Text="Approximate DOB — age will be estimated"/>

                            <!-- Live age display -->
                            <TextBlock x:Name="AgeDisplay" Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0" Visibility="Collapsed"/>
                            <!-- Edit mode: age on admission -->
                            <TextBlock x:Name="AgeOnAdmissionDisplay" Style="{StaticResource MutedText}"
                                       Margin="0,2,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Row 3: Mother PID + Father Name -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,6,0,0">
                            <TextBlock Text="Mother PID" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="MotherPIDInput" Style="{StaticResource InputBox}" Width="80" Margin="0,0,8,0"/>
                                <TextBlock Text="Name (Eng)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="MotherNameInput" Style="{StaticResource InputBox}" Width="180"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,6,0,0">
                            <TextBlock Text="Father Name (Eng)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FatherNameInput" Style="{StaticResource InputBox}" Margin="0,0,0,6"/>
                        </StackPanel>

                        <!-- Row 4: Spouse + Phone -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,4,0,0">
                            <TextBlock Text="Spouse Name (Eng)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SpouseNameInput" Style="{StaticResource InputBox}" Margin="0,0,0,6"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,4,0,0">
                            <TextBlock Text="Phone Nb" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PhoneNumberInput" Style="{StaticResource InputBox}" Margin="0,0,0,6"/>
                        </StackPanel>

                        <!-- Row 5: Address -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,4,0,0">
                            <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AddressCodeInput" Style="{StaticResource InputBox}" Margin="0,0,0,6"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,4,0,0">
                            <TextBlock Text="Address not in list, please specify" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AddressOtherInput" Style="{StaticResource InputBox}" Margin="0,0,0,6"/>
                        </StackPanel>

                        <!-- Row 6: Notes -->
                        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <TextBlock Text="Note" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NotesInput" Style="{StaticResource InputBox}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Height="50" VerticalContentAlignment="Top" Margin="0,0,0,6"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Step 3: Deduplication Check -->
        <Border x:Name="Step3Panel" Grid.Row="4" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="DEDUPLICATION CHECK" Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,12"/>
                <TextBlock x:Name="DedupStatusText" TextWrapping="Wrap"
                           Style="{StaticResource BodyText}" Margin="0,0,0,12"/>

                <ListBox x:Name="DedupResultsList"
                         Background="Transparent" BorderThickness="0"
                         MaxHeight="200" Margin="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgSurfaceDim}"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IDCard}" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentPrimary}"
                                               FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='({0:dd/MM/yyyy})'}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="DedupInstructions" TextWrapping="Wrap"
                           Style="{StaticResource CaptionText}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Step 4: Face Capture -->
        <Border x:Name="Step4Panel" Grid.Row="4" Style="{StaticResource Card}" Visibility="Collapsed"
                Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- Camera Preview -->
                <Grid Grid.Column="0">
                    <Image x:Name="PreviewImage" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="Camera preview"
                               Foreground="{StaticResource TextMuted}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Capture Controls -->
                <StackPanel Grid.Column="2" Margin="0,16,16,16">
                    <TextBlock Text="FACE CAPTURE" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,12"/>

                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" LineHeight="20"
                               Margin="0,0,0,12">
                        Face the camera directly and click Capture.
                    </TextBlock>

                    <Button x:Name="CaptureButton"
                            Content="Capture Face"
                            Click="OnCaptureClick"
                            Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12"/>

                    <!-- Biometric re-capture warning (edit mode) -->
                    <TextBlock x:Name="FaceRecaptureWarning" Style="{StaticResource WarningText}"
                               Text="New capture will add to existing biometrics"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <TextBlock Text="Biometric Remark:" Style="{StaticResource FieldLabel}"
                               Margin="0,8,0,2"/>
                    <ComboBox x:Name="FaceRemarkCombo" Margin="0,0,0,12"/>

                    <Border Background="{StaticResource BgSurfaceDim}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="10,8">
                        <TextBlock x:Name="CaptureStatusLabel"
                                   Text="Ready to capture"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Step 5: Fingerprint Capture -->
        <Border x:Name="Step5Panel" Grid.Row="4" Style="{StaticResource Card}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Fingerprint Image Preview -->
                <Grid Grid.Column="0">
                    <Border Background="{StaticResource BgSurfaceDim}" CornerRadius="6"
                            Padding="20">
                        <Image x:Name="FingerprintPreview" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock x:Name="FingerprintPlaceholder"
                               Text="Place finger on scanner"
                               Foreground="{StaticResource TextMuted}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Controls -->
                <StackPanel Grid.Column="2" Margin="0,16,16,16">
                    <TextBlock Text="FINGERPRINT CAPTURE" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Select Finger:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="FingerTypeCombo" Margin="0,0,0,10"/>

                    <TextBlock x:Name="FpCaptureProgress" Text="0 of 3 captures"
                               Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>

                    <Border Background="{StaticResource BgSurfaceDim}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="10,8" Margin="0,0,0,10">
                        <TextBlock x:Name="FpStatusLabel"
                                   Text="Scanner not connected"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Fingerprint Remark:" Style="{StaticResource FieldLabel}"
                               Margin="0,8,0,2"/>
                    <ComboBox x:Name="FingerprintRemarkCombo" Margin="0,0,0,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════ -->
        <!-- NAVIGATION BUTTONS                  -->
        <!-- ═══════════════════════════════════ -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Content="Back"
                    Click="OnBackClick"
                    Style="{StaticResource BtnBase}"
                    Visibility="Collapsed"/>

            <Button x:Name="NextButton" Grid.Column="2"
                    Content="Next"
                    Click="OnNextClick"
                    Style="{StaticResource BtnPrimary}"/>

            <Button Grid.Column="4"
                    Content="Cancel"
                    Click="OnCancelClick"
                    Style="{StaticResource BtnBase}"/>
        </Grid>
    </Grid>
</Window>
