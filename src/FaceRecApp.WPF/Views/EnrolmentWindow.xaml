<Window x:Class="FaceRecApp.WPF.Views.EnrolmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient Enrolment"
        Height="660" Width="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Patient Enrolment"
                   Style="{StaticResource PageTitle}"/>

        <!-- Step Indicator -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock x:Name="StepIndicator"
                       Text="Step 1 of 5 — e-Consent"
                       Style="{StaticResource CaptionText}"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════ -->
        <!-- STEP CONTENT AREA                       -->
        <!-- ═══════════════════════════════════════ -->

        <!-- Step 1: e-Consent -->
        <Border x:Name="Step1Panel" Grid.Row="4" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="BIOMETRIC DATA CONSENT" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="ConsentTextBlock" TextWrapping="Wrap"
                               Style="{StaticResource BodyText}" LineHeight="22"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Purposes:" Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" LineHeight="20"
                               Margin="16,0,0,16">
                        1. Accurate Identification — prevent patient mix-ups
                        <LineBreak/>
                        2. Faster Service — instant check-in for future visits
                        <LineBreak/>
                        3. Data Security — strictly confidential, high-security standards
                    </TextBlock>

                    <CheckBox x:Name="ConsentCheckBox" Margin="0,8,0,0"
                              FontSize="13" Foreground="{StaticResource TextPrimary}">
                        <TextBlock Text="I Agree to biometric data collection" FontWeight="SemiBold"/>
                    </CheckBox>

                    <StackPanel x:Name="DeclinePanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Reason for declining (required):" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DeclineReasonInput" Style="{StaticResource InputBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Step 2: Demographics -->
        <Border x:Name="Step2Panel" Grid.Row="4" Style="{StaticResource Card}" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="PATIENT DEMOGRAPHICS" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Full Name + Sex -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Full Name *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FullNameInput" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Sex *" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                <RadioButton x:Name="SexMale" Content="Male" GroupName="Sex"
                                             FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0"/>
                                <RadioButton x:Name="SexFemale" Content="Female" GroupName="Sex"
                                             FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Row 1: DOB -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Date of Birth" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                <TextBox x:Name="DOBYearInput" Style="{StaticResource InputBox}"
                                         Width="70" Margin="0,0,8,0" />
                                <TextBlock Text="Year" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ComboBox x:Name="DOBMonthCombo" Width="130" Margin="0,0,8,0"/>
                                <TextBlock Text="Month" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ComboBox x:Name="DOBDayCombo" Width="130" Margin="0,0,8,0"/>
                                <TextBlock Text="Day" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Row 2: Address -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Address Code" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AddressCodeInput" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Address Other" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AddressOtherInput" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>
                        </StackPanel>

                        <!-- Row 3: Family -->
                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Text="Mother's Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MotherNameInput" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <TextBlock Text="Father's Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FatherNameInput" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>
                        </StackPanel>

                        <!-- Row 4: Spouse + Notes -->
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Spouse's Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SpouseNameInput" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NotesInput" Style="{StaticResource InputBox}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Height="50" VerticalContentAlignment="Top" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Step 3: Deduplication Check -->
        <Border x:Name="Step3Panel" Grid.Row="4" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="DEDUPLICATION CHECK" Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,12"/>
                <TextBlock x:Name="DedupStatusText" TextWrapping="Wrap"
                           Style="{StaticResource BodyText}" Margin="0,0,0,12"/>

                <ListBox x:Name="DedupResultsList"
                         Background="Transparent" BorderThickness="0"
                         MaxHeight="200" Margin="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgSurfaceDim}"
                                    CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IDCard}" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentPrimary}"
                                               FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='({0:dd/MM/yyyy})'}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="DedupInstructions" TextWrapping="Wrap"
                           Style="{StaticResource CaptionText}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Step 4: Face Capture -->
        <Border x:Name="Step4Panel" Grid.Row="4" Style="{StaticResource Card}" Visibility="Collapsed"
                Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- Camera Preview -->
                <Grid Grid.Column="0">
                    <Image x:Name="PreviewImage" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="Camera preview"
                               Foreground="{StaticResource TextMuted}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Capture Controls -->
                <StackPanel Grid.Column="2" Margin="0,16,16,16">
                    <TextBlock Text="FACE CAPTURE" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,12"/>

                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" LineHeight="20"
                               Margin="0,0,0,12">
                        Face the camera directly and click Capture.
                    </TextBlock>

                    <Button x:Name="CaptureButton"
                            Content="Capture Face"
                            Click="OnCaptureClick"
                            Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12"/>

                    <TextBlock Text="Biometric Remark:" Style="{StaticResource FieldLabel}"
                               Margin="0,8,0,2"/>
                    <ComboBox x:Name="FaceRemarkCombo" Margin="0,0,0,12"/>

                    <Border Background="{StaticResource BgSurfaceDim}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1" CornerRadius="5"
                            Padding="10,8">
                        <TextBlock x:Name="CaptureStatusLabel"
                                   Text="Ready to capture"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Step 5: Fingerprint Capture -->
        <Border x:Name="Step5Panel" Grid.Row="4" Style="{StaticResource Card}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Fingerprint Image Preview -->
                <Grid Grid.Column="0">
                    <Border Background="{StaticResource BgSurfaceDim}" CornerRadius="6"
                            Padding="20">
                        <Image x:Name="FingerprintPreview" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock x:Name="FingerprintPlaceholder"
                               Text="Place finger on scanner"
                               Foreground="{StaticResource TextMuted}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Controls -->
                <StackPanel Grid.Column="2" Margin="0,16,16,16">
                    <TextBlock Text="FINGERPRINT CAPTURE" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,12"/>

                    <!-- Finger Selector -->
                    <TextBlock Text="Select Finger:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="FingerTypeCombo" Margin="0,0,0,10"/>

                    <!-- Capture Progress -->
                    <TextBlock x:Name="FpCaptureProgress" Text="0 of 3 captures"
                               Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>

                    <!-- Scanner Status -->
                    <Border Background="{StaticResource BgSurfaceDim}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1" CornerRadius="5"
                            Padding="10,8" Margin="0,0,0,10">
                        <TextBlock x:Name="FpStatusLabel"
                                   Text="Scanner not connected"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Remark (if capture impossible) -->
                    <TextBlock Text="Fingerprint Remark:" Style="{StaticResource FieldLabel}"
                               Margin="0,8,0,2"/>
                    <ComboBox x:Name="FingerprintRemarkCombo" Margin="0,0,0,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Content="Back"
                    Click="OnBackClick"
                    Style="{StaticResource BtnBase}"
                    Visibility="Collapsed"/>

            <Button x:Name="NextButton" Grid.Column="2"
                    Content="Next"
                    Click="OnNextClick"
                    Style="{StaticResource BtnPrimary}"/>

            <Button Grid.Column="4"
                    Content="Cancel"
                    Click="OnCancelClick"
                    Style="{StaticResource BtnBase}"/>
        </Grid>
    </Grid>
</Window>
