<Window
    x:Class="FaceRecApp.WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FaceRecApp.WPF.Converters"
    xmlns:vm="clr-namespace:FaceRecApp.WPF.ViewModels"
    Title="Face Recognition"
    Width="1280"
    Height="780"
    MinWidth="1020"
    MinHeight="580"
    Background="{DynamicResource BgPrimary}"
    WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding IdentifyCommand}" />
        <KeyBinding Key="F9" Command="{Binding ToggleCameraCommand}" />
        <KeyBinding
            Key="N"
            Command="{Binding OpenRegisterCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D"
            Command="{Binding OpenDatabaseCommand}"
            Modifiers="Ctrl" />
        <KeyBinding Key="F2" Command="{Binding StartOverCommand}" />
    </Window.InputBindings>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ══════════════════════════════════════  -->
        <!--  TOP BAR  -->
        <!--  ══════════════════════════════════════  -->
        <Border
            Grid.Row="0"
            Padding="16,10"
            Background="{DynamicResource BgDark}">
            <DockPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextOnDark}"
                    Text="Face Recognition" />

                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <ComboBox
                        Width="180"
                        Margin="0,0,4,0"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding CameraDevices}"
                        SelectedItem="{Binding SelectedCamera}"
                        Style="{DynamicResource DarkComboBox}" />
                    <Button
                        Width="32"
                        Margin="0,0,6,0"
                        Background="#3D3835"
                        Command="{Binding RefreshCameraDevicesCommand}"
                        Content="&#x21BB;"
                        FontSize="14"
                        Foreground="{DynamicResource TextOnDark}"
                        Style="{DynamicResource BtnBase}"
                        ToolTip="Refresh camera list" />
                    <Button
                        Width="120"
                        Margin="0,0,6,0"
                        Command="{Binding ToggleCameraCommand}"
                        Content="{Binding IsCameraRunning, Converter={x:Static local:Converters.CameraButtonText}}"
                        Style="{DynamicResource BtnPrimary}" />
                    <Button
                        Margin="0,0,6,0"
                        Background="#3D3835"
                        Command="{Binding OpenRegisterCommand}"
                        Content="Enrol"
                        Foreground="{DynamicResource TextOnDark}"
                        Style="{DynamicResource BtnBase}" />
                    <Button
                        Margin="0,0,6,0"
                        Background="#3D3835"
                        Command="{Binding OpenDatabaseCommand}"
                        Content="Database"
                        Foreground="{DynamicResource TextOnDark}"
                        Style="{DynamicResource BtnBase}" />
                    <Button
                        Margin="0,0,6,0"
                        Background="#3D3835"
                        Command="{Binding OpenBenchmarkCommand}"
                        Content="Benchmark"
                        Foreground="{DynamicResource TextOnDark}"
                        Style="{DynamicResource BtnBase}" />
                    <Button
                        Background="#3D3835"
                        Command="{Binding ResetLivenessCommand}"
                        Content="Reset Liveness"
                        Foreground="{DynamicResource TextOnDark}"
                        Style="{DynamicResource BtnBase}" />
                </StackPanel>

                <StackPanel
                    Margin="24,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,20,0"
                        FontSize="12"
                        Foreground="#A8A29E"
                        Text="{Binding FpsText}" />
                    <TextBlock
                        Margin="0,0,20,0"
                        FontSize="12"
                        Foreground="#A8A29E"
                        Text="{Binding DatabaseText}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#A8A29E"
                        Text="{Binding LivenessText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  ══════════════════════════════════════  -->
        <!--  MAIN CONTENT  -->
        <!--  ══════════════════════════════════════  -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!--  Camera Feed  -->
            <Border
                Grid.Column="0"
                Padding="0"
                ClipToBounds="True"
                Style="{DynamicResource Card}">
                <Grid>
                    <Image
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Source="{Binding CameraFrame}"
                        Stretch="Uniform" />

                    <!--  Placeholder  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsCameraRunning, Converter={x:Static local:Converters.InverseBoolToVis}}">
                        <TextBlock
                            Margin="0,0,0,6"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="Medium"
                            Foreground="{DynamicResource TextMuted}"
                            Text="Camera Off" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextMuted}"
                            Text="Click Start Camera to begin" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ═══════════════════════════════════════  -->
            <!--  WORKFLOW PANEL (scrollable)  -->
            <!--  ═══════════════════════════════════════  -->
            <ScrollViewer
                Grid.Column="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!--  ═══════════════════════════════  -->
                    <!--  CARD 1: IDENTIFY  -->
                    <!--  ═══════════════════════════════  -->
                    <Border Margin="0,0,0,8" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{DynamicResource SectionHeader}"
                                Text="IDENTIFY" />

                            <!--  ① Face Recognition  -->
                            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource AccentPrimary}"
                                    Text="&#x2460;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="FACE RECOGNITION" />
                            </StackPanel>
                            <Button
                                Margin="0,0,0,12"
                                HorizontalAlignment="Stretch"
                                Command="{Binding IdentifyCommand}"
                                Content="Identify Patient (1:N)"
                                IsEnabled="{Binding IsCameraRunning}"
                                Style="{DynamicResource BtnPrimary}" />

                            <!--  ② Biometric Search  -->
                            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource AccentPrimary}"
                                    Text="&#x2461;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="BIOMETRIC SEARCH" />
                            </StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding PhotoSearchCommand}"
                                    Content="Search by Photo"
                                    Style="{DynamicResource BtnBase}" />
                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding FingerprintSearchCommand}"
                                    Content="Fingerprint"
                                    Style="{DynamicResource BtnBase}" />
                            </Grid>

                            <!--  ③ Manual Search  -->
                            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource AccentPrimary}"
                                    Text="&#x2462;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="MANUAL SEARCH" />
                            </StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Style="{DynamicResource InputBox}"
                                    Text="{Binding ManualSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="2"
                                    Padding="14,8"
                                    Command="{Binding ManualSearchCommand}"
                                    Content="Search"
                                    Style="{DynamicResource BtnBase}" />
                            </Grid>

                            <!--  Search Results  -->
                            <ItemsControl ItemsSource="{Binding ManualSearchResults}" Visibility="{Binding HasManualSearchResults, Converter={x:Static local:Converters.BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,4"
                                            Padding="8,6"
                                            Background="{DynamicResource BgSurfaceDim}"
                                            CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock
                                                            Margin="0,0,6,0"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource AccentPrimary}"
                                                            Text="{Binding IDCard}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="Medium"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            Text="{Binding Name}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.SelectPatientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Select"
                                                    Style="{DynamicResource BtnSmall}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  Identify Result Badge  -->
                            <Border Margin="0,4,0,0" Visibility="{Binding HasIdentifyResult, Converter={x:Static local:Converters.BoolToVis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Border
                                            Padding="10,4"
                                            Background="{Binding IdentifyResultColor}"
                                            CornerRadius="3"
                                            DockPanel.Dock="Left">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#FFFFFF"
                                                Text="{Binding IdentifyResultHeader}" />
                                        </Border>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Right"
                                            Style="{DynamicResource MonoText}"
                                            Text="{Binding PatientIdentifyTiming}" />
                                    </DockPanel>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{Binding IdentifyResultText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding IdentifyResultText, Converter={x:Static local:Converters.NonEmptyToVisible}}" />
                                </StackPanel>
                            </Border>

                            <!--  Enrol New (when unknown)  -->
                            <Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding EnrolNewCommand}"
                                Content="Enrol New Patient"
                                Style="{DynamicResource BtnBase}"
                                Visibility="{Binding ShowEnrolNewOption, Converter={x:Static local:Converters.BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!--  ═══════════════════════════════  -->
                    <!--  CARD 2: PATIENT CARD  -->
                    <!--  ═══════════════════════════════  -->
                    <Border
                        Margin="0,0,0,8"
                        Style="{DynamicResource Card}"
                        Visibility="{Binding ShowPatientCard, Converter={x:Static local:Converters.BoolToVis}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,8"
                                Style="{DynamicResource SectionHeader}"
                                Text="PATIENT" />

                            <!--  PID + Name + Sex/Age  -->
                            <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,10,0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentPrimary}"
                                    Text="{Binding PatientPid}"
                                    Visibility="{Binding PatientPid, Converter={x:Static local:Converters.NonEmptyToVisible}}" />
                                <TextBlock
                                    Margin="0,0,10,0"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{Binding PatientName}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="{Binding PatientSex, Mode=OneWay}" />
                                    <Run Text="{Binding PatientAge, Mode=OneWay, StringFormat='  {0}'}" />
                                </TextBlock>
                            </StackPanel>

                            <!--  Biometric Update Warning  -->
                            <Border
                                Margin="0,6,0,0"
                                Padding="10,8"
                                Background="{DynamicResource BgWarning}"
                                CornerRadius="4"
                                Visibility="{Binding NeedsBiometricUpdate, Converter={x:Static local:Converters.BoolToVis}}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextWarning}"
                                    TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="Biometric update recommended." />
                                    <Run Text="Patient found via name search. Face verification is recommended." />
                                </TextBlock>
                            </Border>

                            <!--  Action Buttons  -->
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,6,0"
                                    Padding="12,6"
                                    Command="{Binding GoToVerifyCommand}"
                                    Content="Verify Face"
                                    FontSize="12"
                                    Style="{DynamicResource BtnPrimary}" />
                                <Button
                                    Margin="0,0,6,0"
                                    Padding="12,6"
                                    Command="{Binding GoToVisitCommand}"
                                    Content="Log Visit"
                                    FontSize="12"
                                    Style="{DynamicResource BtnBase}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  ═══════════════════════════════  -->
                    <!--  CARD 3: VERIFY (1:1)  -->
                    <!--  ═══════════════════════════════  -->
                    <Border
                        Margin="0,0,0,8"
                        Style="{DynamicResource Card}"
                        Visibility="{Binding ShowVerifySection, Converter={x:Static local:Converters.BoolToVis}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{DynamicResource SectionHeader}"
                                Text="VERIFY" />

                            <!--  Verify Button  -->
                            <Button
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                Command="{Binding VerifyPatientCommand}"
                                Content="Verify Face (1:1)"
                                IsEnabled="{Binding IsCameraRunning}"
                                Style="{DynamicResource BtnPrimary}" />

                            <!--  Verify Result Badge  -->
                            <Border Margin="0,0,0,8" Visibility="{Binding HasVerifyResult, Converter={x:Static local:Converters.BoolToVis}}">
                                <StackPanel>
                                    <Border
                                        Padding="10,4"
                                        HorizontalAlignment="Left"
                                        Background="{Binding VerifyResultColor}"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="#FFFFFF"
                                            Text="{Binding VerifyResultHeader}" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{Binding VerifyResultText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding VerifyResultText, Converter={x:Static local:Converters.NonEmptyToVisible}}" />
                                </StackPanel>
                            </Border>

                            <!--  Facial Change Checkbox  -->
                            <CheckBox
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="{DynamicResource TextPrimary}"
                                IsChecked="{Binding FacialChangeChecked}">
                                <TextBlock Text="Facial Change (trauma, surgery, aging)" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBox
                                Margin="20,0,0,8"
                                Style="{DynamicResource InputBox}"
                                Text="{Binding FacialChangeReason, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding FacialChangeChecked, Converter={x:Static local:Converters.BoolToVis}}" />

                            <!--  Update Photo  -->
                            <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                <Button
                                    Padding="12,6"
                                    Command="{Binding UpdatePhotoCommand}"
                                    Content="Update Photo"
                                    FontSize="12"
                                    IsEnabled="{Binding IsCameraRunning}"
                                    Style="{DynamicResource BtnBase}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{Binding PhotoUpdateStatus}"
                                    Visibility="{Binding PhotoUpdateStatus, Converter={x:Static local:Converters.NonEmptyToVisible}}" />
                            </StackPanel>

                            <!--  Continue to Visit  -->
                            <Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding GoToVisitCommand}"
                                Content="Continue to Visit"
                                Style="{DynamicResource BtnPrimary}" />
                        </StackPanel>
                    </Border>

                    <!--  ═══════════════════════════════  -->
                    <!--  CARD 4: VISIT  -->
                    <!--  ═══════════════════════════════  -->
                    <Border
                        Margin="0,0,0,8"
                        Style="{DynamicResource Card}"
                        Visibility="{Binding ShowVisitSection, Converter={x:Static local:Converters.BoolToVis}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{DynamicResource SectionHeader}"
                                Text="LOG VISIT" />

                            <!--  Service Type  -->
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Service Type *" />
                            <ComboBox
                                Margin="0,0,0,10"
                                ItemsSource="{Binding ServiceTypes}"
                                SelectedItem="{Binding VisitServiceType}" />

                            <!--  Chief Complaint  -->
                            <TextBlock Style="{DynamicResource FieldLabel}" Text="Chief Complaint" />
                            <TextBox
                                Height="60"
                                Margin="0,0,0,10"
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True"
                                Style="{DynamicResource InputBox}"
                                Text="{Binding VisitChiefComplaint, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />

                            <!--  Log Visit Button  -->
                            <Button
                                Margin="0,0,0,6"
                                HorizontalAlignment="Stretch"
                                Command="{Binding LogVisitCommand}"
                                Content="Log Visit"
                                Style="{DynamicResource BtnPrimary}" />

                            <!--  Success Message  -->
                            <Border
                                Padding="10,8"
                                Background="{DynamicResource BgSuccess}"
                                CornerRadius="4"
                                Visibility="{Binding VisitLogged, Converter={x:Static local:Converters.BoolToVis}}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSuccess}"
                                    Text="Visit logged successfully." />
                            </Border>

                            <!--  Print Routing Slip  -->
                            <Button
                                Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding PrintRoutingSlipCommand}"
                                Content="Print Routing Slip"
                                Style="{DynamicResource BtnBase}"
                                Visibility="{Binding VisitLogged, Converter={x:Static local:Converters.BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!--  ═══════════════════════════════  -->
                    <!--  CARD 5: ACTIVITY LOG  -->
                    <!--  ═══════════════════════════════  -->
                    <Border Margin="0,0,0,8" Style="{DynamicResource Card}">
                        <DockPanel>
                            <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left"
                                    Style="{DynamicResource SectionHeader}"
                                    Text="ACTIVITY" />
                                <Button
                                    Command="{Binding ClearLogCommand}"
                                    Content="Clear"
                                    DockPanel.Dock="Right"
                                    Style="{DynamicResource BtnSmall}" />
                            </DockPanel>

                            <ListBox
                                MaxHeight="150"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Cascadia Code, Consolas, monospace"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondary}"
                                ItemsSource="{Binding ActivityLog}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0,2" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!--  Start Over  -->
                    <Button
                        Margin="0,0,0,8"
                        HorizontalAlignment="Right"
                        Command="{Binding StartOverCommand}"
                        Content="Start Over"
                        Style="{DynamicResource BtnSmall}" />

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  ══════════════════════════════════════  -->
        <!--  STATUS BAR  -->
        <!--  ══════════════════════════════════════  -->
        <Border
            Grid.Row="2"
            Padding="16,8"
            Background="{DynamicResource BgSurfaceDim}"
            BorderBrush="{DynamicResource BorderLight}"
            BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock
                    DockPanel.Dock="Left"
                    Style="{DynamicResource CaptionText}"
                    Text="{Binding StatusText}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Style="{DynamicResource MonoText}"
                    Text="{Binding TimingText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
