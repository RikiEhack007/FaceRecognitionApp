<Window x:Class="FaceRecApp.WPF.Views.VisitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Visit"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Log Visit" Style="{StaticResource PageTitle}"/>

        <!-- Patient Info -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="PATIENT" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PatientPidLabel" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentPrimary}" FontSize="14"
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="PatientNameLabel"
                               Foreground="{StaticResource TextPrimary}" FontSize="14"
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="PatientSexLabel"
                               Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Visit Form -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Service Type *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ServiceTypeCombo" Margin="0,2,0,12"/>

                <TextBlock Text="Chief Complaint" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ChiefComplaintInput" Style="{StaticResource InputBox}"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Height="70" VerticalContentAlignment="Top"/>
            </StackPanel>
        </Border>

        <!-- Visit History -->
        <Border Grid.Row="6" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="VISIT HISTORY"
                           Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                <ListBox x:Name="VisitHistoryList"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding VisitDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12" Width="120"/>
                                <TextBlock Text="{Binding ServiceType}"
                                           Foreground="{StaticResource AccentPrimary}"
                                           FontSize="12" FontWeight="SemiBold" Width="80"/>
                                <TextBlock Text="{Binding ChiefComplaint}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LogVisitButton"
                    Content="Log Visit"
                    Click="OnLogVisitClick"
                    Style="{StaticResource BtnPrimary}"
                    Margin="0,0,8,0"/>
            <Button Content="Close"
                    Click="OnCloseClick"
                    Style="{StaticResource BtnBase}"/>
        </StackPanel>
    </Grid>
</Window>
