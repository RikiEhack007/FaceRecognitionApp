<Window x:Class="FaceRecApp.WPF.Views.DatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient Database"
        Height="600" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}">

    <Window.Resources>
        <Style x:Key="DgColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceDim}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Patient Database"
                   Style="{DynamicResource PageTitle}"/>

        <!-- Search -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Search:" Foreground="{DynamicResource TextSecondary}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchInput" Width="250" Style="{DynamicResource InputBox}"
                         Margin="0,0,8,0" KeyDown="OnSearchKeyDown"/>
                <Button Content="Search" Click="OnSearchClick"
                        Style="{DynamicResource BtnPrimary}" Padding="12,6"/>
                <Button Content="Show All" Click="OnRefreshClick"
                        Style="{DynamicResource BtnBase}" Padding="12,6" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Stats -->
        <Border Grid.Row="4" Style="{DynamicResource Card}" Padding="14,10">
            <WrapPanel>
                <TextBlock x:Name="StatPersons" Style="{DynamicResource CaptionText}"
                           Margin="0,0,24,0"/>
                <TextBlock x:Name="StatSamples" Style="{DynamicResource CaptionText}"
                           Margin="0,0,24,0"/>
                <TextBlock x:Name="StatRecognitions" Style="{DynamicResource CaptionText}"
                           Margin="0,0,24,0"/>
                <TextBlock x:Name="StatRate" Style="{DynamicResource CaptionText}"/>
            </WrapPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid x:Name="PersonsGrid" Grid.Row="6"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="{DynamicResource BgSurface}"
                  Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource BorderDefault}"
                  BorderThickness="1"
                  RowBackground="{DynamicResource BgSurface}"
                  AlternatingRowBackground="{DynamicResource BgSurfaceDim}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderLight}"
                  HeadersVisibility="Column"
                  ColumnHeaderStyle="{DynamicResource DgColumnHeader}"
                  FontSize="12"
                  CanUserResizeRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID" Binding="{Binding IDCard}" Width="80"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Sex" Binding="{Binding Sex}" Width="45"/>
                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="50"/>
                <DataGridTextColumn Header="Samples" Binding="{Binding FaceSampleCount}" Width="65"/>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedOn}" Width="120"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Note}" Width="120"/>
            </DataGrid.Columns>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BgSurfaceDim}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="34"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BgSurfaceDim}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Edit Patient"
                    Click="OnEditClick"
                    Style="{DynamicResource BtnPrimary}"
                    Margin="0,0,8,0"/>
            <Button Content="View Visits"
                    Click="OnViewVisitsClick"
                    Style="{DynamicResource BtnBase}"
                    Margin="0,0,8,0"/>
            <Button Content="Refresh"
                    Click="OnRefreshClick"
                    Style="{DynamicResource BtnBase}"
                    Margin="0,0,8,0"/>
            <Button Content="Delete Selected"
                    Click="OnDeleteClick"
                    Style="{DynamicResource BtnDanger}"
                    Margin="0,0,8,0"/>
            <Button Content="Close"
                    Click="OnCloseClick"
                    Style="{DynamicResource BtnBase}"/>
        </StackPanel>
    </Grid>
</Window>
